# Copy to backend/.env and fill in. Never commit real keys.
# Provider: claude_cli (your Claude subscription via the `claude` CLI - no API key), anthropic, openai or ollama
# For claude_cli use an alias such as `sonnet` (the subscription may not serve dated model IDs)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
SQL_DIALECT=sqlite

ANTHROPIC_API_KEY=
# claude_cli provider: path to the CLI (default: `claude` on PATH) and per-call timeout in seconds
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT=120
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

BUSINESS_DB_PATH=data/business.db
ADMIN_DB_PATH=data/admin.db
CHROMA_PATH=data/chroma
CORS_ORIGINS=http://localhost:3000
QUERY_TIMEOUT_SECONDS=10
REFERENCE_DATE=2025-12-31

# Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Embeddings for few-shot retrieval: "default" (Chroma MiniLM, downloads once) or "hashing" (offline)
EMBEDDING_BACKEND=default

# Semantic cache: reuse SQL for near-identical repeated questions (saves LLM tokens)
SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95
