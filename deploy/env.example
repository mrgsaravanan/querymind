# Copy to ../.env on the server (cp deploy/env.example .env) and fill in. Never commit .env.

# The address people will open. A real domain pointing at the server's IP, or a free name like 203-0-113-10.sslip.io
DOMAIN=your-domain.example.com

# Pays for the model calls (console.anthropic.com). Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Locks the Admin UI and /admin API. Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# Spend protection: questions per visitor per hour, and a hard daily ceiling for everyone combined
RATE_LIMIT_PER_HOUR=30
DAILY_QUERY_CAP=500

# Optional
LLM_MODEL=claude-sonnet-4-20250514
ALLOW_TABLE_IMPORT=true
